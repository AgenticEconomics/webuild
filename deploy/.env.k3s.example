# Generated by deploy/scripts/k3s-prepare.sh — copy to deploy/.env.k3s.
# Sandbox pods dial RELAY_URL on the k3s node IP (host port 80).

K3S_NODE_IP=127.0.0.1
DB_PASSWORD=change-me
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

INVITE_EMAIL=vitacardia@localhost
RELAY_INTERNAL_TOKEN=change-me-internal-agent-token
RELAY_URL=ws://127.0.0.1/ws/relay
HUB_WS_URL=ws://127.0.0.1/ws/hub

SANDBOX_IMAGE=docker.io/library/webuild-sandbox:local
SANDBOX_IMAGE_PULL_SECRET=none
SANDBOX_IMAGE_PULL_POLICY=IfNotPresent
SANDBOX_AGENT=webuild
SANDBOX_CPU_REQUEST=500m
SANDBOX_MEMORY_REQUEST=1Gi
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4Gi
SANDBOX_EPHEMERAL_STORAGE=8Gi
WEBUILD_YOLO=1
MODEL=qwen-max
DASHSCOPE_API_KEY=
